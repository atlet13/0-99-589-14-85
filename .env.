# Підключення до Neon Postgres (Render > Environment)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Секрет для підпису JWT — згенеруй довгий випадковий рядок
JWT_SECRET=replace-with-long-random-string

# Доступ до адмін-панелі
ADMIN_USER=admin
ADMIN_PASSWORD=задай-надійний-пароль
# Альтернатива: bcrypt-хеш пароля (тоді ADMIN_PASSWORD ігнорується)
# ADMIN_PASSWORD_HASH=

# Порт (Render задає автоматично, локально — 3000)
PORT=3000
